# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Service role key — server-only, bypasses RLS. Used only by the Stripe webhook.
# Find it in Supabase Dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Stripe — no NEXT_PUBLIC_ prefix; these are server-only secrets.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET: get from Stripe Dashboard → Webhooks → your endpoint → signing secret.
# Required for webhook signature verification — requests without a valid signature are rejected.
STRIPE_WEBHOOK_SECRET=whsec_...

# Public base URL used for Stripe success/cancel redirect URLs.
# Set to your deployed domain in production (no trailing slash).
# Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
